# Database
# The database path is determined by NODE_ENV:
# - test: ./data/howcani.test.db (automatically set by Bun test runner)
# - development: ./data/howcani.db (default)
# - production: Uses DATABASE_URL (defaults to ./data/howcani.db if not set)
DATABASE_URL=./data/howcani.db

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=1h
JWT_REFRESH_EXPIRATION=7d

# Server
PORT=3000
NODE_ENV=development

# GitHub Import (one-time migration)
GITHUB_TOKEN=your-github-token-for-import
GITHUB_REPO=janbaer/howcani

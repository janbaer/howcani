# HowCanI Docker Compose Configuration
# Copy this file to .env and customize the values for your deployment

# Application Port
# The port where the application will be accessible
# Both host and container use the same port
# Default: 3000
HOWCANI_PORT=3000

# Data Directory
# Path on the host system where application data will be stored
# This directory will be mounted to /data inside the container
# Ensure this directory exists and has appropriate permissions
# Default: ./data (relative to docker-compose.yml location)
HOWCANI_DATA_DIR=./data

# User ID
# The user ID that the application process will run as inside the container
# Should match the owner of the data directory on the host
# Default: 1000
HOWCANI_UID=1000

# Group ID
# The group ID that the application process will run as inside the container
# Should match the group owner of the data directory on the host
# Default: 1000
HOWCANI_GID=1000

# JWT Secret (required)
# Used for signing and verifying authentication tokens
# Generate a secure secret with: openssl rand -base64 32
HOWCANI_JWT_SECRET=

# Example configurations for different deployment scenarios:

# Production deployment with custom port and data location:
# HOWCANI_PORT=8080
# HOWCANI_DATA_DIR=/var/lib/howcani/data
# HOWCANI_UID=1001
# HOWCANI_GID=1001

# Development deployment with default settings:
# HOWCANI_PORT=3000
# HOWCANI_DATA_DIR=./data
# HOWCANI_UID=1000
# HOWCANI_GID=1000

# Home lab deployment on non-standard port:
# HOWCANI_PORT=9090
# HOWCANI_DATA_DIR=/mnt/storage/howcani/data
# HOWCANI_UID=1000
# HOWCANI_GID=1000

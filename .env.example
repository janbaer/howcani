# HowCanI Configuration
# Copy this file to .env and fill in your values

# Application port (default: 3000)
HOWCANI_PORT=3000

# Host directory for data persistence (default: ./data)
HOWCANI_DATA_DIR=./data

# Host directory for backup files (default: ./data/backups)
HOWCANI_BACKUP_DIR=./data/backups

# User and group ID for container file permissions (default: 1000)
HOWCANI_UID=1000
HOWCANI_GID=1000

# JWT signing secret (required)
# Generate with: openssl rand -base64 32
HOWCANI_JWT_SECRET=

# OpenRouter API key (optional)
# Enables semantic search via vector embeddings. Without it, search uses FTS5 only.
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# Embedding model (optional, default: openai/text-embedding-3-small)
# EMBEDDING_MODEL=openai/text-embedding-3-small

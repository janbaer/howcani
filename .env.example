# HowCanI Configuration
# Copy this file to .env and fill in your values

# Application port (default: 3000)
HOWCANI_PORT=3000

# Host directory for data persistence (default: ./data)
HOWCANI_DATA_DIR=./data

# Host directory for backup files (default: ./data/backups)
HOWCANI_BACKUP_DIR=./data/backups

# User and group ID for container file permissions (default: 1000)
HOWCANI_UID=1000
HOWCANI_GID=1000

# JWT signing secret (required)
# Generate with: openssl rand -base64 32
HOWCANI_JWT_SECRET=

# Embedding provider (optional)
# When unset, semantic search is disabled and only FTS5 is used.
# Supported values: openrouter, llamacpp
# EMBEDDING_PROVIDER=openrouter

# Embedding model (optional)
# Default depends on EMBEDDING_PROVIDER:
#   openrouter → openai/text-embedding-3-small
#   llamacpp   → nomic-embed-text-v1.5
# EMBEDDING_MODEL=openai/text-embedding-3-small

# Embedding vector dimension (optional, default: 1536)
# Must match the model. text-embedding-3-small=1536, nomic-embed-text-v1.5=768.
# Changing this requires EMBEDDING_ALLOW_DIMENSION_RESET=true on the next boot.
# EMBEDDING_DIMENSION=1536

# OpenRouter API key (required when EMBEDDING_PROVIDER=openrouter)
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=

# llama.cpp endpoint (required when EMBEDDING_PROVIDER=llamacpp)
# OpenAI-compatible /v1/embeddings URL. No auth header is sent.
# EMBEDDING_ENDPOINT=https://llm.example/v1/embeddings

# One-shot wipe of stored embeddings (optional)
# Set to "true" when switching providers or changing EMBEDDING_DIMENSION.
# Without this flag, a dimension/model mismatch at startup is fatal.
# Remove after the next deploy completes successfully.
# EMBEDDING_ALLOW_DIMENSION_RESET=true

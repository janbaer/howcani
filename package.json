{
  "name": "howcani",
  "private": true,
  "version": "3.0.96",
  "type": "module",
  "scripts": {
    "dev": "bun --hot run src/server/index.ts",
    "dev:css": "bunx @tailwindcss/cli -i src/styles/app.css -o src/styles/main.css --watch",
    "build": "NODE_ENV=production bun run build-client.ts",
    "build:docker": "./scripts/build-docker.sh",
    "cleanup:docker": "./scripts/cleanup-docker.sh",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check ./src/",
    "lint:fix": "bunx @biomejs/biome check --fix ./src/",
    "lint:dead": "bunx fallow dead-code",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "mcp-inspect": "bunx @modelcontextprotocol/inspector",
    "postinstall": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint",
    "pre-push": "bun run build && bun test"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.2",
    "@types/bun": "1.3.14",
    "bun-plugin-svelte": "0.0.6",
    "simple-git-hooks": "2.13.1",
    "svelte": "5.56.4",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.5",
    "@codemirror/language": "6.12.4"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.0",
    "@codemirror/view": "6.43.5",
    "@lezer/highlight": "1.2.3",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/dompurify": "3.2.0",
    "dompurify": "3.4.11",
    "elysia": "1.4.29",
    "http-status-codes": "2.3.0",
    "jose": "6.2.3",
    "marked": "18.0.5",
    "sqlite-vec": "0.1.9",
    "zod": "4.4.3"
  }
}

{
  "name": "howcani",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "NODE_ENV=production bun run scripts/build.ts",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",

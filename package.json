{
  "name": "howcani",
  "private": true,
  "version": "3.0.41",
  "type": "module",
  "scripts": {
    "dev": "bun --hot run src/server/index.ts",
    "dev:css": "bunx @tailwindcss/cli -i src/styles/app.css -o src/styles/main.css --watch",
    "build": "NODE_ENV=production bun run build-client.ts",
    "build:docker": "./scripts/build-docker.sh",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check ./src/",
    "lint:fix": "bunx @biomejs/biome check --fix ./src/",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "mcp-inspect": "npx @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.2.1",
    "@types/bun": "1.3.9",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "bun-plugin-svelte": "0.0.6",
    "globals": "17.3.0",
    "svelte": "5.53.5",
    "svelte-check": "4.4.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.27.1",
    "@types/dompurify": "3.2.0",
    "codemirror": "5.65.19",
    "dompurify": "3.3.1",
    "elysia": "1.4.26",
    "http-status-codes": "2.3.0",
    "jose": "6.1.3",
    "marked": "17.0.3",
    "sqlite-vec": "0.1.7-alpha.2"
  }
}

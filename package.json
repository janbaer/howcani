{
  "name": "howcani",
  "private": true,
  "version": "3.0.118",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'trap \"trap - INT TERM EXIT; kill 0\" INT TERM EXIT; bun --hot run src/server/index.ts & tail -f /dev/null | bun run dev:css & wait'",
    "dev:css": "bunx @tailwindcss/cli -i src/styles/app.css -o src/styles/main.css --watch",
    "build": "NODE_ENV=production bun run build-client.ts",
    "build:docker": "./scripts/build-docker.sh",
    "cleanup:docker": "./scripts/cleanup-docker.sh",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "check:svelte": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "bunx @biomejs/biome check ./src/",
    "lint:fix": "bunx @biomejs/biome check --fix ./src/",
    "lint:dead": "bunx fallow dead-code",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "mcp-inspect": "bunx @modelcontextprotocol/inspector",
    "postinstall": "bunx simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint",
    "pre-push": "bun run build && bun check && bun run check:svelte && bun run lint:dead && bun test --isolate"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/bun": "1.4.4",
    "bun-plugin-svelte": "0.0.6",
    "simple-git-hooks": "2.14.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@codemirror/state": "$@codemirror/state",
    "@codemirror/view": "$@codemirror/view",
    "@codemirror/language": "$@codemirror/language",
    "@hono/node-server": "1.19.17",
    "hono": "4.13.13",
    "express-rate-limit": "8.7.1",
    "ip-address": "10.7.4",
    "fast-uri": "3.1.9",
    "path-to-regexp": "8.4.2"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "dompurify": "3.4.17",
    "elysia": "1.4.30",
    "http-status-codes": "2.3.0",
    "jose": "6.2.13",
    "marked": "18.1.1",
    "sqlite-vec": "0.1.9",
    "zod": "4.6.7"
  }
}

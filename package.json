{
  "name": "howcani",
  "private": true,
  "version": "3.0.19",
  "type": "module",
  "scripts": {
    "dev": "bun --hot run src/server/index.ts",
    "build": "NODE_ENV=production bun run build-client.ts",
    "build:docker": "./scripts/build-docker.sh",
    "start": "NODE_ENV=production bun run src/server/index.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "bunx @biomejs/biome check ./src/",
    "lint:fix": "bunx @biomejs/biome check --fix ./src/",
    "db:migrate": "bun run src/server/db/migrate.ts",
    "export:github": "bun run src/tools/export-github.ts",
    "import:json": "bun run src/tools/import-json.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.1.16",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "bun-plugin-svelte": "0.0.6",
    "globals": "^16.5.0",
    "svelte": "^5.45.6",
    "svelte-check": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.52.0"
  },
  "dependencies": {
    "@types/dompurify": "3.2.0",
    "codemirror": "^5.65.18",
    "dompurify": "3.3.1",
    "elysia": "1.4.19",
    "http-status-codes": "2.3.0",
    "jose": "6.1.3",
    "marked": "17.0.1"
  }
}
